{
  "name": "nile-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Modular e-commerce marketplace backend",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "migrate": "node-pg-migrate --migrations-dir src/migrations --check-order",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down",
    "migrate:create": "pnpm migrate create --migration-file-language sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5"
  }
}
