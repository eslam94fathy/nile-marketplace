# Copy to .env for local development. Never commit .env.

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (docker-compose also uses these to create the local server) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nile
POSTGRES_PASSWORD=nile
POSTGRES_DB=nile
DB_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- RabbitMQ (docker-compose also uses these to create the local broker) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nile
RABBITMQ_PASSWORD=nile
RABBITMQ_VHOST=
RABBITMQ_TLS=false

# --- Outbox worker ---
WORKER_HEALTH_PORT=3001
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# --- Docker Compose only ---
RABBITMQ_MANAGEMENT_PORT=15672
