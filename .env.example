# Copy to .env for local development. Never commit .env.

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://nile:nile@localhost:5432/nile
TEST_DATABASE_URL=postgres://nile:nile@localhost:5432/nile_test
DB_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://nile:nile@localhost:5672

# --- Outbox worker ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# --- Docker Compose (local infrastructure only) ---
POSTGRES_USER=nile
POSTGRES_PASSWORD=nile
POSTGRES_DB=nile
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_USER=nile
RABBITMQ_PASSWORD=nile
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672